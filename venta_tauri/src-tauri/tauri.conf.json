{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BUEN TRAGO",
  "version": "1.0.14",
  "identifier": "com.altotrago.vinoteca",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BUEN TRAGO",
        "width": 1500,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
